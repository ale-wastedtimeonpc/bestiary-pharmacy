#!/usr/bin/env bash
# mai_piu — "never again": a line that a fix should have made disappear, has it come back since the last restart?
#
# From the Wasted Time on PC bestiary (https://wastedtimeonpc.com/bestiario): on 18 November 2026 a self-hosted AI assistant, when
# its translation service returned nothing, quietly fell back to a local model, which improvised. The fix removes that fallback
# on that path and makes the assistant say what happened. A fallback that silently comes back is the same monster, back in the
# house: this counts the lines with the old message, but only after the LAST start of the service, so lines from before the fix
# don't count.
#
# Usage:   mai_piu <log-file> "<forbidden text>" ["<text that marks a start>"]
# Example: mai_piu /var/log/myapp.log "falling back to local model" "Application startup complete"
# Notes:   the match is a fixed string and case-sensitive; it counts LINES (a line with the text twice counts once).
#          Without the third argument, or if no start line is found, the whole file counts (and it says so).
#          Works on logs with stray binary bytes. Plain files only (not .gz, not pipes).
# Read-only. Exit code 0 = not back, 1 = back, 2 = cannot check.
set -u -o pipefail
[ $# -ge 2 ] || { sed -n '2,17p' "$0"; exit 2; }
log=$1; vietata=$2; avvio=${3:-}
[ -f "$log" ] && [ -r "$log" ] || { echo "cannot read $log (must be a readable plain file)"; exit 2; }
start=1
if [ -n "$avvio" ]; then
  start=$(grep -anF -- "$avvio" "$log" | tail -n 1 | cut -d: -f1) || start=""
  if [ -z "$start" ]; then echo "no start line found: counting the whole file"; start=1; fi
fi
n=$(tail -n +"$start" -- "$log" | grep -acF -- "$vietata") || n=${n:-0}
case "$n" in ''|*[!0-9]*) echo "cannot count in $log"; exit 2 ;; esac
echo "from line $start of $log: $n line(s) with the forbidden text"
[ "$n" -eq 0 ] && exit 0 || exit 1
